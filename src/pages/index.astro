---
import BaseLayout from "../layouts/BaseLayout.astro";

const specialties = [
  ["01", "Ortodoncia", "Planificación para niños, adolescentes y adultos."],
  ["02", "Odontología integral", "Prevención, diagnóstico y rehabilitación."],
  ["03", "Tecnología láser", "Una herramienta precisa cuando está indicada."],
  ["04", "ATM y dolor orofacial", "Una mirada integral de la articulación y la mordida."],
];
---

<BaseLayout>
  <header class="site-header">
    <a class="brand" href="#inicio" aria-label="Dra. Edith Noriega, inicio">
      <strong><span>Dra.</span> Edith Noriega</strong>
      <small>Odontóloga · Ortodoncista</small>
    </a>
    <nav aria-label="Navegación principal">
      <a href="#especialidades">Especialidades</a>
      <a href="#primera-consulta">Primera consulta</a>
      <a href="#doctora">La doctora</a>
    </nav>
    <a class="button button--dark" href="#contacto">Pedí tu turno <span aria-hidden="true">↗</span></a>
  </header>

  <main id="inicio">
    <section class="hero">
      <div class="hero__copy">
        <p class="eyebrow"><i></i> Atención en La Plata y Quilmes</p>
        <h1>Tu sonrisa<br />merece una mirada <em>integral.</em></h1>
        <p class="lead">Experiencia, tecnología y calidez para acompañarte en cada etapa de tu salud bucal.</p>
        <div class="hero__actions">
          <a class="button button--primary" href="https://wa.me/5492213185753" target="_blank" rel="noopener">Escribinos por WhatsApp <span aria-hidden="true">→</span></a>
          <a class="text-link" href="#especialidades">Conocé los tratamientos <span aria-hidden="true">↓</span></a>
        </div>
      </div>
      <div class="hero__art" aria-label="Ilustración decorativa de una sonrisa" role="img">
        <div class="arch arch--one"></div><div class="arch arch--two"></div>
        <div class="sun"><span></span><span></span><span></span></div>
        <p>Una atención<br />que empieza por<br /><b>escucharte.</b></p>
        <div class="spark spark--a">✦</div><div class="spark spark--b">✦</div>
      </div>
      <p class="hero__foot">Más de <strong>20 años</strong> dedicados a la ortodoncia <span>↓</span></p>
    </section>

    <section class="intro" id="doctora">
      <p class="eyebrow">Una forma de atender</p>
      <div class="intro__grid">
        <h2>La salud bucal forma parte de tu bienestar <em>general.</em></h2>
        <div><p>La Dra. Edith Noriega combina una trayectoria clínica de más de dos décadas con actualización constante y una mirada interdisciplinaria.</p><a class="text-link" href="#contacto">Conocé a la doctora <span aria-hidden="true">→</span></a></div>
      </div>
    </section>

    <section class="specialties" id="especialidades">
      <div class="section-heading"><div><p class="eyebrow">Especialidades</p><h2>Tratamientos pensados<br />para cada persona.</h2></div><p>La indicación siempre surge de una evaluación individual, sin recetas universales.</p></div>
      <div class="specialty-grid">
        {specialties.map(([number, title, copy], index) => <article class:list={["specialty", { "specialty--accent": index === 0 }]}><span>{number}</span><h3>{title}</h3><p>{copy}</p><a href="#contacto" aria-label={`Consultar sobre ${title}`}>↗</a></article>)}
      </div>
    </section>

    <section class="consultation" id="primera-consulta">
      <div class="consultation__number">01</div>
      <div><p class="eyebrow">Tu primera consulta</p><h2>Empezamos por entender qué necesitás.</h2></div>
      <ol><li><span>01</span><b>Te escuchamos</b><p>Conversamos sobre el motivo de tu consulta y tus antecedentes.</p></li><li><span>02</span><b>Evaluamos</b><p>Hacemos un diagnóstico integral y definimos si hacen falta estudios.</p></li><li><span>03</span><b>Planificamos</b><p>Te explicamos alternativas, prioridades y próximos pasos.</p></li></ol>
    </section>

    <section class="contact" id="contacto">
      <div class="contact__shape"></div>
      <p class="eyebrow">Turnos y consultas</p>
      <h2>Hablemos de tu<br /><em>sonrisa.</em></h2>
      <p>Elegí el consultorio que te quede más cómodo y coordinamos tu turno por WhatsApp.</p>
      <a class="button button--mint" href="https://wa.me/5492213185753" target="_blank" rel="noopener">Enviar un mensaje <span aria-hidden="true">→</span></a>
      <div class="locations"><p><b>La Plata</b><br />Calle 49 n.º 390</p><p><b>Quilmes</b><br />Hipólito Yrigoyen 439</p></div>
    </section>
  </main>

  <footer><span>© {new Date().getFullYear()} Dra. Edith Noriega</span><span>La información es orientativa y no reemplaza una consulta profesional.</span><a href="#inicio">Volver arriba ↑</a></footer>
</BaseLayout>

<style>
  :global(*) { box-sizing: border-box; } :global(html) { scroll-behavior: smooth; } :global(body) { margin: 0; background: #f8f8f5; color: #182027; font-family: "DM Sans", sans-serif; } :global(a) { color: inherit; }
  .site-header { height: 86px; padding: 0 clamp(22px, 5vw, 78px); display:flex; align-items:center; justify-content:space-between; border-bottom:1px solid #d8ddd7; position:relative; z-index:2; background:#f8f8f5; } .brand { text-decoration:none; display:grid; gap:2px; } .brand strong { font: 700 19px/1 "Fraunces", serif; letter-spacing:-.05em; } .brand strong span { color:#4e43bf; } .brand small { font-size:10px; letter-spacing:.12em; text-transform:uppercase; color:#64706f; } nav { display:flex; gap:clamp(18px,3vw,44px); } nav a { text-decoration:none; font-size:14px; font-weight:600; } nav a:hover,.text-link:hover { color:#4e43bf; }
  .button { display:inline-flex; align-items:center; justify-content:center; gap:24px; padding:15px 20px; text-decoration:none; border-radius:100px; font-size:14px; font-weight:700; transition:transform .2s, background .2s; } .button:hover { transform:translateY(-2px); } .button--dark { background:#182027; color:#fff; } .button--primary { background:#5145c7; color:#fff; } .button--mint { background:#bff1dc; color:#17332d; } .text-link { display:inline-flex; gap:12px; align-items:center; text-decoration:none; font-weight:700; font-size:14px; border-bottom:1px solid currentColor; padding-bottom:4px; }
  .hero { min-height:620px; padding:clamp(62px,9vw,132px) clamp(22px,10vw,155px) 40px; background:#edecff; display:grid; grid-template-columns:1.12fr .88fr; position:relative; overflow:hidden; } .eyebrow { margin:0 0 18px; text-transform:uppercase; letter-spacing:.14em; font-size:11px; font-weight:700; color:#3d7571; } .eyebrow i { display:inline-block; width:8px; height:8px; border-radius:50%; background:#51c9b5; margin-right:8px; } h1,h2,h3,p { margin-top:0; } h1 { max-width:720px; font:600 clamp(47px,6vw,84px)/.98 "Fraunces",serif; letter-spacing:-.065em; } em { color:#5145c7; font-style:italic; } .lead { max-width:510px; font-size:19px; line-height:1.55; color:#556064; margin:28px 0; } .hero__actions { display:flex; align-items:center; gap:28px; flex-wrap:wrap; } .hero__foot { position:absolute; left:clamp(22px,10vw,155px); bottom:24px; font-size:12px; color:#5f6669; } .hero__foot strong { color:#5145c7; } .hero__foot span { margin-left:14px; font-size:18px; }
  .hero__art { min-height:400px; position:relative; align-self:center; } .arch { position:absolute; border-radius:50% 50% 0 0; border:1px solid #aca8ec; width:320px; height:390px; bottom:-105px; right:8%; } .arch--two { width:212px; height:270px; border-color:#70cfc1; bottom:-106px; right:30%; } .sun { width:146px; height:146px; background:#59cdbc; border-radius:50%; position:absolute; top:66px; right:23%; display:grid; place-items:center; box-shadow: 24px 30px 0 #fff8d8; } .sun:before,.sun:after { content:""; position:absolute; background:#f8f8f5; border-radius:99px; } .sun:before { width:9px; height:43px; transform:rotate(45deg); } .sun:after { width:43px; height:9px; transform:rotate(45deg); } .sun span { width:6px; height:22px; background:#f8f8f5; position:absolute; border-radius:4px; } .sun span:nth-child(1){ transform:translate(-22px,15px) rotate(-40deg) }.sun span:nth-child(2){transform:translate(22px,15px) rotate(40deg)}.sun span:nth-child(3){transform:translateY(36px)} .hero__art p { position:absolute; right:4%; bottom:54px; font:600 24px/1.12 "Fraunces",serif; letter-spacing:-.04em; z-index:1; }.spark { position:absolute; color:#5145c7; font-size:32px; }.spark--a{top:42px;left:12%}.spark--b{bottom:125px;left:10%;font-size:20px;color:#54c8b7}
  .intro { padding:130px clamp(22px,10vw,155px); } .intro__grid { display:grid; grid-template-columns:1.1fr .65fr; gap:11vw; align-items:end; } h2 { font:600 clamp(37px,4.5vw,64px)/1.03 "Fraunces",serif; letter-spacing:-.06em; } .intro__grid div p,.section-heading>p { color:#596365; line-height:1.65; font-size:17px; margin-bottom:28px; }
  .specialties { padding:100px clamp(22px,7vw,110px); background:#d9f5ed; }.section-heading { display:flex; justify-content:space-between; gap:60px; align-items:end; margin-bottom:55px; }.section-heading h2 { margin-bottom:0; }.section-heading>p { max-width:360px; margin-bottom:0; }.specialty-grid { display:grid; grid-template-columns:repeat(4,1fr); border-top:1px solid #9accc0; }.specialty { min-height:280px; padding:24px; border-right:1px solid #9accc0; position:relative; }.specialty:first-child { border-left:1px solid #9accc0; }.specialty--accent { background:#5145c7; color:#fff; }.specialty span { color:#4a8580; font:600 13px "Fraunces",serif; }.specialty--accent span { color:#c9ffdf; }.specialty h3 { font:600 26px/1.05 "Fraunces",serif; letter-spacing:-.05em; margin:35px 0 13px; }.specialty p { color:#53716d; font-size:14px; line-height:1.5; }.specialty--accent p { color:#e4e1ff; }.specialty a { position:absolute; bottom:20px; right:20px; text-decoration:none; font-size:24px; }
  .consultation { padding:110px clamp(22px,10vw,155px); display:grid; grid-template-columns:.3fr .8fr 1fr; gap:6vw; align-items:start; }.consultation__number { font:600 120px/.7 "Fraunces",serif; color:#deddf0; }.consultation h2 { margin:0; }.consultation ol { list-style:none; padding:0; margin:0; }.consultation li { border-top:1px solid #cdd5d1; padding:17px 0 20px 35px; position:relative; }.consultation li>span { position:absolute; left:0; color:#4e43bf; font-size:11px; font-weight:700; }.consultation li b { font-family:"Fraunces",serif; font-size:19px; }.consultation li p { margin:7px 0 0; color:#64706f; font-size:14px; line-height:1.5; }
  .contact { background:#182027; color:#fff; padding:110px clamp(22px,10vw,155px) 44px; position:relative; overflow:hidden; }.contact .eyebrow { color:#a7e6d1; }.contact h2 { position:relative; z-index:1; margin-bottom:24px; }.contact h2 em { color:#a9edcc; }.contact>p:not(.eyebrow) { max-width:400px; color:#b7c3c1; line-height:1.6; position:relative; z-index:1; }.contact .button { margin-top:12px; position:relative; z-index:1; }.contact__shape { position:absolute; width:600px; height:600px; border:1px solid #48625e; border-radius:50%; right:-100px; top:-280px; }.contact__shape:after { content:""; position:absolute; width:360px; height:360px; border:1px solid #48625e; border-radius:50%; left:80px; top:80px; }.locations { border-top:1px solid #405552; margin-top:92px; padding-top:23px; display:flex; gap:65px; position:relative; z-index:1; }.locations p { color:#aebfbc; font-size:13px; line-height:1.6; margin:0; }.locations b { color:#fff; font-size:14px; }
  footer { min-height:85px; padding:22px clamp(22px,5vw,78px); font-size:12px; color:#687171; display:flex; align-items:center; gap:30px; justify-content:space-between; } footer a { font-weight:700; color:#4e43bf; text-decoration:none; }
  @media (max-width: 820px) { .site-header { height:74px; }.site-header nav { display:none; }.site-header .button--dark { font-size:12px; padding:12px 15px; gap:8px; }.hero { grid-template-columns:1fr; min-height:auto; padding-bottom:85px; }.hero__art { min-height:245px; margin-top:32px; }.sun { top:25px; right:20%; transform:scale(.75); }.arch { transform:scale(.68); transform-origin:bottom right; }.hero__art p{right:4%;bottom:14px;font-size:21px}.spark--a{top:0}.spark--b{bottom:65px}.intro,.specialties,.consultation,.contact { padding-top:75px; padding-bottom:75px; }.intro__grid,.consultation { grid-template-columns:1fr; gap:30px; }.consultation__number { font-size:82px; }.section-heading { display:block; }.section-heading>p { margin-top:22px; }.specialty-grid { grid-template-columns:1fr 1fr; }.specialty:nth-child(3) { border-left:1px solid #9accc0; border-top:1px solid #9accc0; }.specialty:nth-child(4) { border-top:1px solid #9accc0; }.locations { margin-top:60px; gap:24px; }.contact__shape { right:-320px; }.intro h2 { margin-bottom:0; } footer { align-items:flex-start; flex-direction:column; gap:8px; } }
</style>
