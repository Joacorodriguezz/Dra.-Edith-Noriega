---
// La maqueta se conserva como referencia. Las correcciones publicadas se
// aplican desde Astro, sin modificar el archivo de referencia.
import { readFile } from "node:fs/promises";

const reference = await readFile(new URL("../../Dra. Edith Noriega.html", import.meta.url), "utf8");
const head = reference.match(/<head>([\s\S]*?)<\/head>/i)?.[1] ?? "";
const body = reference.match(/<body>([\s\S]*)<\/body>/i)?.[1] ?? reference;
---

<!doctype html>
<html lang="es">
  <head set:html={head}>
    <style is:global>
      .flag, .toggle { display: none !important; }
      .mobilebar { grid-template-columns: minmax(0, 1fr) !important; }
      .mobilebar .en-btn { width: 100%; }
      .brand-mark { display: inline-flex; align-items: center; gap: 10px; white-space: nowrap; }
      .brand-icon { position: relative; display: block; flex: 0 0 28px; width: 28px; height: 28px; overflow: hidden; }
      .brand-icon img { position: absolute; width: 84px; height: 84px; max-width: none; left: 50%; top: 50%; transform: translate(-50%, -50%); mix-blend-mode: multiply; }
      .wordmark .brand-mark b span { color: var(--aqua-ink); }
      @media (max-width: 420px) { .en-nav { gap: 8px; } .brand-mark { gap: 7px; } .wordmark .brand-mark b { font-size: clamp(12px, 3.5vw, 16px); letter-spacing: .02em; } }
      @media (max-width: 760px) { body { padding-bottom: calc(84px + env(safe-area-inset-bottom, 0px)) !important; } .split-illus { grid-template-columns: minmax(0, 1fr) !important; } }
      .training-list { list-style: none; padding: 0; margin: 0; }
      .training-list li { display: grid; grid-template-columns: 112px minmax(0, 1fr); gap: 16px; padding: 16px 0; border-bottom: 1px solid var(--line); }
      .training-list time { color: var(--brand); font: 600 14px/22px var(--font-display); }
      .training-list strong { display: block; font: 600 17px/24px var(--font-display); color: var(--ink); }
      .training-list span { color: var(--ink-muted); }
      .training-more { margin-top: 20px; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
      .training-more summary { padding: 16px 0; cursor: pointer; color: var(--brand); font: 600 15px/22px var(--font-display); }
      .case-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); gap: 24px; align-items: start; }
      .case-card { display: grid; overflow: hidden; background: var(--surface); border-radius: 16px 16px 48px 16px; box-shadow: var(--shadow-soft); }
      .case-card__zoom { position: relative; display: block; width: 100%; padding: 0; border: 0; background: #e9e9e9; cursor: zoom-in; }
      .case-card__zoom img { display: block; width: 100%; height: auto; aspect-ratio: 2435 / 1472; object-fit: contain; }
      .case-card__zoom span { position: absolute; right: 10px; bottom: 10px; padding: 4px 10px; border-radius: 999px; background: rgba(14, 12, 36, .72); color: #fff; font: 600 12px/18px var(--font-display); }
      .case-card__stages { display: flex; flex-wrap: wrap; gap: 6px; padding: 12px 20px 0; }
      .case-card__stages button { padding: 6px 12px; border: 1px solid var(--line); border-radius: 999px; background: var(--surface); color: var(--ink-muted); cursor: pointer; font: 600 13px/18px var(--font-display); }
      .case-card__stages button[aria-pressed="true"] { border-color: var(--brand); background: var(--brand); color: var(--on-brand); }
      .case-card__body { display: grid; gap: 10px; padding: 16px 20px 24px; }
      .case-card__body h3 { margin: 0; font: 600 20px/27px var(--font-display); color: var(--ink); }
      .case-card__body > p { margin: 0; color: var(--ink-muted); }
      .case-card__body blockquote { margin: 0; padding-left: 12px; border-left: 3px solid var(--aqua); color: var(--ink); font: 500 16px/24px var(--font-display); }
      .case-card details { border-top: 1px solid var(--line); }
      .case-card summary { padding-top: 12px; cursor: pointer; color: var(--brand); font: 600 14px/22px var(--font-display); }
      .case-card dl { display: grid; gap: 10px; margin: 12px 0 0; }
      .case-card dt { color: var(--aqua-ink); font: 600 11px/16px var(--font-display); letter-spacing: .12em; text-transform: uppercase; }
      .case-card dd { margin: 2px 0 0; color: var(--ink-muted); font-size: 15px; }
      .case-lightbox { width: min(1200px, 96vw); max-height: 94vh; padding: 0; border: 0; border-radius: 16px; background: var(--surface); }
      .case-lightbox::backdrop { background: rgba(14, 12, 36, .8); }
      .case-lightbox img { display: block; width: 100%; height: auto; max-height: calc(94vh - 56px); object-fit: contain; }
      .case-lightbox__bar { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 10px 16px; color: var(--ink-muted); font-size: 14px; }
      .case-lightbox__bar button { width: 36px; height: 36px; flex: none; border: 1px solid var(--line); border-radius: 50%; background: var(--surface); color: var(--ink); cursor: pointer; font-size: 20px; }
      .voice-carousel { display: grid; gap: 20px; }
      .voice-carousel__track { display: grid; grid-auto-flow: column; grid-auto-columns: 100%; gap: 0; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; overscroll-behavior-x: contain; }
      .voice-carousel__track::-webkit-scrollbar { display: none; }
      .patient-voice { display: grid; grid-template-columns: minmax(0, 340px) minmax(0, 1fr); gap: clamp(24px, 5vw, 64px); align-items: center; scroll-snap-align: start; }
      .patient-voice__photo { margin: 0; aspect-ratio: 4 / 5; overflow: hidden; border-radius: 16px 16px 64px 16px; background: var(--surface); }
      .patient-voice__photo img { display: block; width: 100% !important; height: 100% !important; max-width: none; object-fit: cover; }
      .patient-voice__copy { display: grid; gap: 16px; }
      .patient-voice__copy h2 { margin: 0; font: 700 clamp(24px, 3.2vw, 38px)/1.15 var(--font-display); color: var(--ink); }
      .patient-voice__who { margin: 0; color: var(--ink-muted); }
      .patient-voice__who strong { color: var(--ink); }
      .patient-voice__copy blockquote { margin: 0; padding-left: 16px; border-left: 4px solid var(--aqua); color: var(--ink); font-size: 17px; line-height: 28px; }
      .patient-voice__copy a { justify-self: start; }
      .voice-carousel__nav { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; }
      .voice-carousel__dots { display: flex; flex-wrap: wrap; gap: 8px; }
      .voice-carousel__dots button { width: 12px; height: 12px; padding: 0; border: 0; border-radius: 999px; background: rgba(79, 57, 253, .25); cursor: pointer; transition: width .2s; }
      .voice-carousel__dots button[aria-current="true"] { width: 32px; background: var(--brand); }
      .voice-carousel__arrows { display: flex; align-items: center; gap: 8px; color: var(--ink-muted); font: 600 14px/20px var(--font-display); }
      .voice-carousel__arrows button { width: 44px; height: 44px; border: 1px solid var(--brand); border-radius: 50%; background: var(--surface); color: var(--brand); cursor: pointer; font-size: 22px; }
      .voice-carousel__arrows button:disabled { opacity: .35; cursor: default; }
      @media (max-width: 760px) { .patient-voice { grid-template-columns: minmax(0, 1fr); align-items: start; gap: 20px; } .patient-voice__photo { width: min(100%, 240px); } .patient-voice__copy blockquote { font-size: 16px; line-height: 26px; } }
      .case-stories { display: grid; gap: 28px; }
      .case-stories__head { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 20px; }
      .case-stories__head h2 { max-width: 18ch; margin: 0; font: 700 clamp(30px, 4vw, 48px)/1.1 var(--font-display); }
      .case-stories__controls { display: flex; gap: 8px; }
      .case-stories__controls button { width: 44px; height: 44px; border: 1px solid var(--brand); border-radius: 50%; background: var(--surface); color: var(--brand); cursor: pointer; font-size: 24px; }
      .case-stories__track { display: grid; grid-auto-flow: column; grid-auto-columns: minmax(300px, 430px); gap: 20px; overflow-x: auto; padding: 4px 2px 16px; scroll-snap-type: x mandatory; scrollbar-width: thin; }
      .case-story { display: grid; grid-template-rows: auto 1fr; overflow: hidden; scroll-snap-align: start; background: var(--surface); border-radius: 16px 16px 64px 16px; box-shadow: var(--shadow-soft); }
      .case-story img { display: block; width: 100%; height: auto; aspect-ratio: 2435 / 1472; object-fit: contain; background: #e9e9e9; }
      .case-story__body { display: grid; align-content: start; gap: 12px; padding: 24px; }
      .case-story__body h3 { margin: 0; font: 600 22px/28px var(--font-display); }
      .case-story__body p { margin: 0; color: var(--ink-muted); }
      .case-story__body blockquote { margin: 0; color: var(--ink); font: 500 18px/28px var(--font-display); }
    </style>
  </head>
  <body set:html={body}>
    <script>
      // @ts-nocheck
      const wa = "https://wa.me/5492213185753";
      const training = [["1988–1993", "Odontología", "Facultad de Odontología, Universidad Nacional de La Plata"], ["1995–2000", "Especialista en Ortodoncia", "Facultad de Odontología, Universidad Nacional de La Plata"], ["2008", "Especialista en Ortodoncia Lingual", "Sociedad Argentina de Ortodoncia Lingual"], ["2011–2021", "Ortodoncia pre y posquirúrgica", "Hospital Piñero, Sociedad Argentina de Ortodoncia"], ["2021–2022", "Diplomatura en Odontología Láser y Ciencias de la Salud", "Universidad Abierta Interamericana"], ["2023–2024", "Diplomatura Universitaria en Alineadores Clínico y Diseño", "Universidad Católica de La Plata y Sociedad Argentina de Ortodoncia"]];
      function removeEditorialNotes() { const notes = ["Que la autorización de los tres casos alcance al nuevo sitio", "Que estos días correspondan a La Plata", "La Dra. tiene que confirmar los pasos internos", "El envío del formulario se integra en la etapa de desarrollo"]; document.querySelectorAll("p, span, small").forEach((element) => { if (notes.some((note) => element.textContent.includes(note))) element.remove(); }); }
      function removeDraftStates() {
        document.querySelectorAll(".en-card--soon").forEach((element) => element.remove());
        document.querySelectorAll(".flag").forEach((flag) => flag.closest("details, p, li, article, .notice")?.remove());
        document.querySelectorAll(".faq details").forEach((item) => { if (/pendiente|a confirmar|en desarrollo/i.test(item.textContent)) item.remove(); });
        document.querySelectorAll("p.small, .notice, .muted").forEach((element) => { if (/prototipo|no conectado|se integra al publicar|en preparación|fecha pendiente/i.test(element.textContent)) element.remove(); });
      }
      function replaceCopy() { const display = document.querySelector(".display"); if (display) display.textContent = "Ortodoncia y atención odontológica en La Plata y Quilmes."; const heroLead = document.querySelector(".en-hero__copy .lead"); if (heroLead) heroLead.textContent = "Dra. Edith Noriega, especialista en ortodoncia. Evaluación, tratamiento y seguimiento en ambos consultorios."; document.querySelectorAll(".h1, .h2").forEach((heading) => { if (heading.textContent.trim() === "Una trayectoria dedicada al avance de la ortodoncia") heading.textContent = "Formación y experiencia en ortodoncia"; }); document.querySelectorAll("a, button").forEach((element) => { if (element.textContent.trim() === "Explorar y comparar casos") element.textContent = "Conocé los abordajes clínicos"; }); }
      function simplifyTraining() { const root = document.querySelector("#tlRoot"); if (!root || root.dataset.astroEnhanced) return; root.dataset.astroEnhanced = "true"; root.innerHTML = `<ul class="training-list">${training.map(([period, title, institution]) => `<li><time>${period}</time><div><strong>${title}</strong><span>${institution}</span></div></li>`).join("")}</ul><details class="training-more"><summary>Otros cursos y formación</summary><p class="small">La información adicional se incorpora cuando esté confirmada.</p></details><p class="small" style="margin-top:20px">Actualmente cursa la Especialidad en Láser en Ortodoncia y ATM.</p>`; const section = root.closest(".section"); section?.querySelectorAll(".chips, .seg").forEach((element) => element.remove()); section?.querySelectorAll(".h2").forEach((heading) => { if (heading.textContent.includes("Formación")) heading.textContent = "Formación académica"; }); }
      const cases = [
        { id: "caso-01", label: "Caso 01 · Ortodoncia fija", title: "Apiñamiento severo y una sonrisa que preocupaba", summary: "La paciente llegó con dientes superpuestos, una mordida alterada y ganas de sentirse más cómoda al sonreír.", stages: [["Inicio y 1.ª etapa", "/cases/apinyamiento-02.jpg", "Inicio (diciembre 2022) y primera etapa del tratamiento con brackets"], ["2.ª y 3.ª etapa", "/cases/apinyamiento-01.jpg", "Segunda y tercera etapa del caso de apiñamiento"]], facts: [["Lo que buscamos", "Ordenar la mordida y acompañar el movimiento de los dientes de forma progresiva."], ["Cómo se abordó", "Ortodoncia fija, controles periódicos y seguimiento de cada etapa."], ["La evolución", "La segunda y tercera etapa muestran el cambio gradual del tratamiento."]] },
        { id: "caso-02", label: "Caso 02 · Ortodoncia fija", title: "Clase III y canino retenido, paso a paso", summary: "Había una relación diferente entre las arcadas y un canino que todavía no había erupcionado. No alcanzaba con alinear.", stages: [["Inicio y 1.ª etapa", "/cases/clase-iii-01.jpg", "Inicio y primera etapa de un caso de Clase III con canino retenido"], ["2.ª y 3.ª etapa", "/cases/clase-iii-02.jpg", "Segunda y tercera etapa del caso de Clase III con canino retenido"]], facts: [["Lo que buscamos", "Alinear el canino, ordenar la mordida y recuperar una función más cómoda."], ["Cómo se abordó", "Ortodoncia fija y controles radiográficos durante el proceso."], ["La evolución", "El registro permite ver que los cambios se construyen control a control."]] },
        { id: "caso-03", label: "Caso 03 · Híbrido y láser", title: "“Me habían dicho que mi caso no tenía solución”", summary: "Paciente de 54 años con una Clase II compleja y apiñamiento. A partir de los estudios se planificó una alternativa sin extracciones.", stages: [["Inicio y final", "/cases/hibrido-laser-01.jpg", "Comparación de inicio (junio 2023) y evolución (octubre 2024), con la identidad de la paciente protegida"], ["Estudios", "/cases/hibrido-laser-02.jpg", "Estudios iniciales: radiografía panorámica, telerradiografía de perfil, fotos y escaneo"], ["Etapas", "/cases/hibrido-laser-03.jpg", "Etapas documentadas del tratamiento híbrido con láser"]], facts: [["Cómo se abordó", "Alineadores en la arcada superior, brackets en la inferior y fotobiomodulación láser como apoyo indicado para este caso."], ["La evolución", "El registro fotográfico permite seguir el recorrido sin prometer un resultado igual para otros pacientes."]] },
      ];
      function caseCard(item) {
        const [firstLabel, firstSrc, firstAlt] = item.stages[0];
        const stages = item.stages.length > 1 ? `<div class="case-card__stages" aria-label="Etapas del caso">${item.stages.map(([label, src, alt], index) => `<button type="button" data-stage-src="${src}" data-stage-alt="${alt}" aria-pressed="${index === 0}">${label}</button>`).join("")}</div>` : "";
        return `<article class="case-card" id="${item.id}"><button type="button" class="case-card__zoom" data-case-zoom aria-label="Ampliar imagen: ${firstLabel}"><img src="${firstSrc}" alt="${firstAlt}" width="2435" height="1472" loading="lazy" decoding="async"><span>Ampliar</span></button>${stages}<div class="case-card__body"><p class="eyebrow">${item.label}</p><h3>${item.title}</h3><p>${item.summary}</p>${item.quote ? `<blockquote>${item.quote}</blockquote>` : ""}<details><summary>Cómo se abordó</summary><dl>${item.facts.map(([term, text]) => `<div><dt>${term}</dt><dd>${text}</dd></div>`).join("")}</dl></details></div></article>`;
      }
      function ensureLightbox() {
        let box = document.querySelector("#caseLightbox");
        if (box) return box;
        document.body.insertAdjacentHTML("beforeend", `<dialog class="case-lightbox" id="caseLightbox" aria-label="Imagen ampliada"><img alt=""><div class="case-lightbox__bar"><span></span><button type="button" data-lightbox-close aria-label="Cerrar">×</button></div></dialog>`);
        box = document.querySelector("#caseLightbox");
        box.addEventListener("click", (event) => { if (event.target === box || event.target.closest("[data-lightbox-close]")) box.close(); });
        return box;
      }
      function wireCaseCards(root) {
        root.addEventListener("click", (event) => {
          const stage = event.target.closest("[data-stage-src]");
          if (stage) {
            const card = stage.closest(".case-card");
            const img = card.querySelector(".case-card__zoom img");
            img.src = stage.dataset.stageSrc;
            img.alt = stage.dataset.stageAlt;
            card.querySelector(".case-card__zoom").setAttribute("aria-label", `Ampliar imagen: ${stage.textContent}`);
            card.querySelectorAll("[data-stage-src]").forEach((button) => button.setAttribute("aria-pressed", String(button === stage)));
            return;
          }
          const zoom = event.target.closest("[data-case-zoom]");
          if (!zoom) return;
          const img = zoom.querySelector("img");
          const box = ensureLightbox();
          const big = box.querySelector("img");
          big.src = img.src;
          big.alt = img.alt;
          box.querySelector(".case-lightbox__bar span").textContent = img.alt;
          box.showModal();
        });
      }
      function simplifyCases() {
        const list = document.querySelector("#caseList");
        if (!list || list.dataset.astroCases) return;
        list.dataset.astroCases = "true";
        document.querySelectorAll("#caseAreas, #caseTecs, #caseCount, #compare").forEach((element) => element.remove());
        document.querySelectorAll(".lead").forEach((element) => { if (element.textContent.includes("Podés filtrarlas")) element.textContent = "Tres tratamientos documentados etapa por etapa. Tocá una imagen para verla completa. Cada caso es individual y no anticipa el resultado de otro tratamiento."; });
        list.innerHTML = `<div class="case-grid">${cases.map(caseCard).join("")}</div><p class="small" style="margin-top:var(--space-6)">Las imágenes fueron publicadas con autorización. Cada tratamiento se indica luego de una evaluación individual y sus tiempos y resultados pueden variar.</p>`;
        wireCaseCards(list);
        addPatientVoice(list.closest(".section"));
      }
      const voices = [
        { name: "María Carolina", treatment: "Alineadores + brackets. Tratamiento híbrido acelerado con tecnología láser.", photo: "/testimonios/maria-carolina.jpg", position: "center 40%", video: "https://www.instagram.com/p/DFvjvPzPIL_/", highlight: "Edith es una genia y ha logrado un cambio extraordinario en mi boca.", text: "Mi nombre es Maria Carolina Pluis, y quiero compartir con ustedes el tratamiento extraordinario que hizo Edith en mi boca. Arriba comenzamos con alineadores que semana a semana los ibamos cambiando, con tratamiento de láser para evitar el dolor, cero dolor. Semana a semana he logrado un cambio extraordinario, hemos retraído los dientes de adelante y ampliado la capacidad. Abajo hizo un tratamiento de brackets donde logró alinear todos los dientes, ya que tenía algunos muy atrás y otros apilonados. La verdad es que estoy fascinada, Edith es una genia y ha logrado un cambio extraordinario en mi boca en cuanto a morder, masticar, modular y hablar. La verdad es que estoy fascinada. En un año y medio se han logrado excelentes resultados. Un tratamiento recomendable y magnífico. Edith una genia y excelente profesional." },
        { name: "Gabriel", treatment: "Ortodoncia pre y posquirúrgica + tecnología láser + cirugía ortognática.", photo: "/testimonios/gabriel.jpg", position: "center 40%", video: "https://www.instagram.com/p/DG6X2dAvWpA/", highlight: "La doctora me siguió pasando láser y gracias a eso me recuperé mucho antes.", text: "Me llamo Gabriel, soy paciente de la Dra. Edith Noriega y hace un año más o menos, un año y medio, que estoy en tratamiento de ortodoncia con ella. Ella me viene acompañando en todo lo que es el tratamiento de ortodoncia pre quirúrgico. A su vez pudimos adelantar la recuperación con el tratamiento de láser. Y junto con el cirujano maxilofacial Sebastián Polero, se hizo en varias etapas otro tratamiento aparte para una cirugía ortognática. Hoy en día ya estoy operado gracias a la ayuda de ambos. La doctora me siguió pasando láser y gracias a eso me recuperé mucho antes. Estoy muy agradecido con ambos." },
        { name: "Dora", treatment: "Tratamiento con tecnología láser para neuralgia del trigémino.", photo: "/testimonios/dora.jpg", position: "center 34%", video: "https://www.instagram.com/p/DLF_xT-vhth/", highlight: "Ahora puedo dormir toda la noche. Ya no me duele nada.", text: "Soy Dora, las sesiones me hicieron rebien, ahora puedo dormir toda la noche. Ya no me duele nada, no tengo que estar las noches sentadas porque me dolía demasiado. Las pastillas me calmaban pero no tanto, y me hacían mal, realmente. Yo dejé la medicación y me siento rebien. El láser me hizo rebien, yo no pensé, no tuve fe, es verdad, pero hoy en día se lo recomiendo a cualquiera que tenga ese dolor. Yo tenía una neuralgia de hace diez años y me estaba medicando con una pastilla que me mareaba y no me hacía nada y gracias a Dios la encontré a ella y el dolor ya se me fue." },
        { name: "Catalina", treatment: "Ortodoncia estética con fotobiomodulación con tecnología láser.", photo: "/testimonios/catalina.jpg", position: "center 40%", video: "https://www.instagram.com/p/DAJmmlrvpCG/", highlight: "Recomiendo que se lo vengan a hacer con Edith, para no sufrir dolor.", text: "Soy Cata paciente de Edith y les quiero contar mi testimonio sobre el tratamiento de ortodoncia pero, más que nada, contarles un poco del láser. Se los quería recomendar porque yo estoy haciendo ortodoncia, que sabemos que es un tratamiento muy prolongado en el tiempo, y gracias al láser, que tiene una bioestimulación y además analgesia, hace que no tenga dolor y además que se acelere un montón el tratamiento. Recomiendo que se lo vengan a hacer con Edith, para no sufrir dolor y además que es un amor y amamos ir al dentista gracias a ella." },
        { name: "Guillermo", treatment: "Láser para aftas herpéticas + ortodoncia acelerada con alineadores.", photo: "/testimonios/guillermo.jpg", position: "center 0%", video: "https://www.instagram.com/p/DFvi5QVP01V/", highlight: "En solo seis meses pude finalizar el tratamiento.", text: "Hola, acabo de finalizar mi tratamiento con alineadores y estoy muy contento porque el tratamiento se llevó adelante de manera muy rápida. En solo seis meses pude finalizar el tratamiento y, además de eso, recibí un tratamiento para algo que me venía afectando desde hace muchísimos años, que son las aftas. Yo sufrí de aftas herpéticas, unas aftas muy agresivas que me salían recurrentemente, reiteradamente, prácticamente todos los meses, siempre desde hace muchísimos años y a partir del tratamiento con láser que recibí de manos de Edith, pude reducir significativamente la aparición y los episodios de aftas. Hoy hace por lo menos tres meses que no tengo ningún afta bucal. Así que, muy contento y muy feliz por este tratamiento recibido y lo súperecomiendo." },
        { name: "Vanesa", treatment: "Láser posquirúrgico tras extracciones múltiples. Testimonio de una mamá.", photo: "/testimonios/vanesa.jpg", position: "center 50%", video: "https://www.instagram.com/p/DNY26IxP7yu/", highlight: "Nos sorprendió ampliamente, mucho más de lo que nos imaginamos.", text: "Hola, mi nombre es Vanesa, soy mamá de Elena que tiene 11 años. Ella se tuvo que hacer extracciones múltiples en quirófano junto con Edith que es su dentista y Ariel Ressia que fue el cirujano. La verdad que estamos superagradecidos. Edith nos insistía en que estemos tranquilos porque el posoperatorio con láser iba a adelantar el proceso y no iba a ser invasivo para ella, iba a tener menos dolor y demás. Nosotros confiamos plenamente en ella pero, lo del láser al ser algo nuevo no sabíamos y, la verdad, estamos agradecidos a Edith y al tratamiento posquirúrgico con láser porque nos sorprendió ampliamente, mucho más de lo que nos imaginamos. Elena salió del quirófano con muy poco dolor y con tres sesiones más de aplicación de láser realmente no tuvo más dolor. Ella tuvo doce extracciones con once años y la verdad es que apenas tuvo hinchazón y apenas tuvo dolor." },
      ];
      function voiceSlide(item, index) {
        return `<article class="patient-voice" id="testimonio-${index + 1}" aria-roledescription="diapositiva" aria-label="${index + 1} de ${voices.length}: ${item.name}"><figure class="patient-voice__photo"><img src="${item.photo}" alt="${item.name}, paciente de la Dra. Edith Noriega" width="720" height="1280" loading="lazy" decoding="async" style="object-position:${item.position}"></figure><div class="patient-voice__copy"><h2>“${item.highlight}”</h2><p class="patient-voice__who"><strong>${item.name}</strong> · ${item.treatment}</p><blockquote>${item.text}</blockquote><a class="en-link" href="${item.video}" target="_blank" rel="noopener">Ver su testimonio en video</a></div></article>`;
      }
      function wireVoiceCarousel(root) {
        const track = root.querySelector(".voice-carousel__track");
        const slides = Array.from(track.children);
        const dots = Array.from(root.querySelectorAll("[data-voice-dot]"));
        const prev = root.querySelector("[data-voice-prev]");
        const next = root.querySelector("[data-voice-next]");
        const counter = root.querySelector("[data-voice-count]");
        const current = () => Math.round(track.scrollLeft / Math.max(track.clientWidth, 1));
        const go = (index) => track.scrollTo({ left: Math.max(0, Math.min(slides.length - 1, index)) * track.clientWidth, behavior: "smooth" });
        const update = () => {
          const index = current();
          dots.forEach((dot, i) => dot.setAttribute("aria-current", String(i === index)));
          prev.disabled = index === 0;
          next.disabled = index === slides.length - 1;
          counter.textContent = `${index + 1} / ${slides.length}`;
          slides.forEach((slide, i) => slide.toggleAttribute("inert", i !== index));
        };
        prev.addEventListener("click", () => go(current() - 1));
        next.addEventListener("click", () => go(current() + 1));
        dots.forEach((dot, i) => dot.addEventListener("click", () => go(i)));
        let frame = 0;
        track.addEventListener("scroll", () => { cancelAnimationFrame(frame); frame = requestAnimationFrame(update); }, { passive: true });
        update();
      }
      function addPatientVoice(afterSection) {
        if (!afterSection || afterSection.nextElementSibling?.classList.contains("patient-voice-section")) return;
        const tone = afterSection.classList.contains("section--aqua") ? "" : " section--aqua";
        const dots = voices.map((item, i) => `<button type="button" data-voice-dot aria-label="Ver testimonio de ${item.name}"></button>`).join("");
        afterSection.insertAdjacentHTML("afterend", `<section class="section${tone} patient-voice-section"><div class="wrap"><div class="voice-carousel" aria-roledescription="carrusel" aria-label="La voz de mis pacientes"><p class="eyebrow">La voz de mis pacientes</p><div class="voice-carousel__track">${voices.map(voiceSlide).join("")}</div><div class="voice-carousel__nav"><div class="voice-carousel__dots">${dots}</div><div class="voice-carousel__arrows"><span data-voice-count aria-live="polite"></span><button type="button" data-voice-prev aria-label="Testimonio anterior">←</button><button type="button" data-voice-next aria-label="Testimonio siguiente">→</button></div></div></div></div></section>`);
        wireVoiceCarousel(afterSection.nextElementSibling);
      }
      function enhanceHomeStories() {
        const section = Array.from(document.querySelectorAll(".section")).find((element) => element.textContent.includes("Casos reales, explicados paso a paso"));
        if (!section || section.dataset.astroStories) return;
        section.dataset.astroStories = "true";
        const wrap = section.querySelector(".wrap");
        if (!wrap) return;
        wrap.innerHTML = `<div class="case-stories"><div class="case-stories__head"><div><p class="eyebrow">Historias clínicas</p><h2>Casos reales, explicados paso a paso</h2><p>Qué preocupaba a cada persona, qué se evaluó y cómo se construyó el tratamiento.</p></div><div class="case-stories__controls" aria-label="Navegar historias"><button type="button" data-stories-prev aria-label="Historia anterior">←</button><button type="button" data-stories-next aria-label="Historia siguiente">→</button></div></div><div class="case-stories__track" aria-label="Historias clínicas"><article class="case-story"><img src="/cases/apinyamiento-02.jpg" alt="Inicio de un caso de apiñamiento severo"><div class="case-story__body"><p class="eyebrow">Apiñamiento severo</p><h3>Volver a sentirse cómoda al sonreír</h3><p>La consulta empezó por una mordida alterada y dientes superpuestos. El recorrido se documentó etapa por etapa con ortodoncia fija.</p><a class="en-link" href="#casos">Ver el caso</a></div></article><article class="case-story"><img src="/cases/clase-iii-01.jpg" alt="Inicio de un caso de Clase III y canino retenido"><div class="case-story__body"><p class="eyebrow">Clase III y canino retenido</p><h3>Un tratamiento que necesitaba tiempo y seguimiento</h3><p>El objetivo no era solo alinear: también había que acompañar la erupción del canino y la relación entre ambas arcadas.</p><a class="en-link" href="#casos">Ver el caso</a></div></article><article class="case-story"><img src="/cases/hibrido-laser-01.jpg" alt="Comparación de inicio y evolución de una paciente adulta con identidad protegida"><div class="case-story__body"><p class="eyebrow">Ortodoncia híbrida y láser</p><h3>Encontrar una alternativa</h3><blockquote>“Me habían dicho que no tenía solución ni un tratamiento alternativo.”</blockquote><a class="en-link" href="#casos">Ver el caso</a></div></article></div><a class="en-btn en-btn--outline" href="#casos" style="justify-self:start">Conocé todos los casos</a></div>`;
        const track = wrap.querySelector(".case-stories__track");
        wrap.querySelector("[data-stories-prev]")?.addEventListener("click", () => track.scrollBy({ left: -track.clientWidth * .8, behavior: "smooth" }));
        wrap.querySelector("[data-stories-next]")?.addEventListener("click", () => track.scrollBy({ left: track.clientWidth * .8, behavior: "smooth" }));
        addPatientVoice(section);
      }
      function simplifyContact() { document.querySelectorAll(".ph").forEach((element) => { if (element.textContent.includes("Mapa de La Plata") || element.textContent.includes("Mapa de Quilmes")) element.remove(); }); document.querySelectorAll(".today").forEach((element) => { element.textContent = "Horarios habituales. Confirmá tu turno por WhatsApp."; }); const form = document.querySelector("#cform"); if (!form || form.dataset.astroEnhanced) return; form.dataset.astroEnhanced = "true"; form.querySelector("#f-wa-w")?.remove(); const intro = document.querySelector("#form-sec .en-section-head"); if (intro) { intro.querySelector(".h2").textContent = "Prepará tu mensaje"; const text = intro.querySelector("p:not(.eyebrow)"); if (text) text.textContent = "Completá estos datos y abriremos WhatsApp con un mensaje listo para revisar y enviar."; } const submit = form.querySelector('[type="submit"]'); if (submit) submit.textContent = "Continuar por WhatsApp"; form.addEventListener("submit", (event) => { event.preventDefault(); event.stopImmediatePropagation(); const name = form.querySelector("#f-nombre")?.value.trim(); const area = form.querySelector("#f-area"); const seat = form.querySelector('input[name="sede"]:checked')?.value || "sin preferencia"; const reason = form.querySelector("#f-motivo")?.value.trim(); const status = form.querySelector("#formMsg"); if (!name) { status.textContent = "Escribí tu nombre para preparar el mensaje."; form.querySelector("#f-nombre")?.focus(); return; } const selectedArea = area?.value ? area.options[area.selectedIndex].text : "orientación general"; const message = `Hola, soy ${name}. Quiero consultar por ${selectedArea}. Consultorio preferido: ${seat}.${reason ? ` Motivo: ${reason}` : ""}`; window.open(`${wa}?text=${encodeURIComponent(message)}`, "_blank", "noopener"); status.textContent = "Abrimos WhatsApp con tu mensaje preparado. Revisalo y envialo cuando estés listo."; }, true); }
      function applyBrand() { document.querySelectorAll(".navbar .wordmark, .sheet .wordmark").forEach((element) => { if (element.dataset.brandApplied) return; element.dataset.brandApplied = "true"; if (element.matches("a")) element.setAttribute("aria-label", "Dra. Edith Noriega. Ir al inicio"); element.innerHTML = '<span class="brand-mark"><span class="brand-icon"><img src="/brand/dental-icon.jpeg" alt="" width="1600" height="1600"></span><b><span>Dra.</span> Edith Noriega</b></span>'; }); }
      function enhance() { document.body.classList.add("no-flags"); document.querySelectorAll(".net").forEach((element) => element.closest(".section")?.remove()); document.querySelectorAll(".mobilebar a").forEach((element) => { element.href = wa; element.target = "_blank"; element.rel = "noopener"; element.textContent = "Pedí tu turno por WhatsApp"; }); removeEditorialNotes(); removeDraftStates(); replaceCopy(); simplifyTraining(); simplifyCases(); simplifyContact(); enhanceHomeStories(); applyBrand(); }
      enhance(); window.addEventListener("hashchange", () => window.setTimeout(enhance, 0));
    </script>
  </body>
</html>
