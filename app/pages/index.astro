---
import Base from "../layouts/Base.astro";
import Hero from "../components/home/Hero.astro";
import Creds from "../components/home/Creds.astro";
import NeedsGuide from "../components/home/NeedsGuide.astro";
import ServicesBento from "../components/home/ServicesBento.astro";
import CaseStories from "../components/home/CaseStories.astro";
import TrainingTimeline from "../components/home/TrainingTimeline.astro";
import VoiceCarousel from "../components/casos/VoiceCarousel.astro";
import SectionHeader from "../components/ui/SectionHeader.astro";
import Steps from "../components/ui/Steps.astro";
import Faq from "../components/ui/Faq.astro";
import TodayStatus from "../components/contacto/TodayStatus.astro";
import SedeCard from "../components/contacto/SedeCard.astro";
import { SITE } from "../data/site";
import { SEDES } from "../data/sedes";
import { FAQ_HOME } from "../data/faqs";

const pasos = [
  { t: "Pedís el turno", d: "Por WhatsApp, eligiendo el consultorio de La Plata o el de Quilmes." },
  { t: "Evaluación", d: "Conversación sobre el motivo de consulta y revisión clínica." },
  { t: "Estudios, si hacen falta", d: "Según el caso, una radiografía panorámica o una cefalometría." },
  { t: "Plan y seguimiento", d: "Las alternativas, las etapas y los controles." }
];
---

<Base title={SITE.titulo} description="Ortodoncia y atención odontológica en La Plata y Quilmes con la Dra. Edith Noriega: evaluación, tratamiento y seguimiento. Pedí tu turno por WhatsApp.">
  <script is:inline slot="head">
    // Links viejos con hash (#ortodoncia, #casos...) llevan a la ruta nueva. #necesidades es un ancla real.
    function irARutaNueva() {
      var h = location.hash.slice(1);
      if (!h) return;
      var areas = ["odontologia-general", "ortodoncia", "laser", "atm", "ortodoncia-quirurgica"];
      var rutas = { inicio: "/", tratamientos: "/tratamientos/", "la-doctora": "/la-doctora/", casos: "/casos/", "primera-consulta": "/primera-consulta/", conocimiento: "/", contacto: "/contacto/" };
      var destino = areas.indexOf(h) > -1 ? "/tratamientos/" + h + "/" : rutas[h];
      if (destino) location.replace(destino);
    }
    irARutaNueva();
    window.addEventListener("hashchange", irARutaNueva);
  </script>

  <Hero home eyebrow="Odontóloga · Ortodoncista" title="Ortodoncia y atención odontológica en La Plata y Quilmes." lead="Dra. Edith Noriega, especialista en ortodoncia. Evaluación, tratamiento y seguimiento en ambos consultorios." />
  <Creds />
  <NeedsGuide />
  <ServicesBento />
  <CaseStories />
  <VoiceCarousel tone="paper" />
  <TrainingTimeline />

  <section class="section section--surface">
    <div class="wrap">
      <div class="head-row">
        <SectionHeader eyebrow="Tu primera consulta" title="Qué pasa cuando pedís un turno" text="No hace falta saber de antemano qué tratamiento necesitás." />
        <a class="en-link" href="/primera-consulta/">Ver cómo es una primera consulta</a>
      </div>
      <Steps steps={pasos} />
    </div>
  </section>

  <section class="section section--tint">
    <div class="wrap split">
      <SectionHeader eyebrow="Preguntas frecuentes" title="Dudas antes de consultar" text="Si tu pregunta no está acá, escribinos por WhatsApp." />
      <Faq items={FAQ_HOME} />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="head-row">
        <SectionHeader eyebrow="Contacto" title="Pedí tu turno" text="Los turnos se coordinan por WhatsApp. Elegí el consultorio que te quede más cómodo." />
        <TodayStatus />
      </div>
      <div class="en-contact">
        {SEDES.map((s) => <SedeCard sede={s} />)}
        <div class="en-sede" style="background:var(--surface-tint);box-shadow:none">
          <p class="eyebrow">Otra forma de consultar</p>
          <h3 class="h3">Dejanos tu consulta por área</h3>
          <p>Indicá qué área te interesa y te preparamos el mensaje para WhatsApp.</p>
          <a class="en-btn en-btn--outline" href="/contacto/#form-sec">Ir al formulario</a>
        </div>
      </div>
    </div>
  </section>
</Base>
