---
import Base from "../layouts/Base.astro";
import PageHead from "../components/ui/PageHead.astro";
import CaseCard from "../components/casos/CaseCard.astro";
import VoiceCarousel from "../components/casos/VoiceCarousel.astro";
import { CASES } from "../data/cases";
import { SITE_URL, pageTitle } from "../data/site";
import { breadcrumbList } from "../lib/schema";

const crumbs = [{ label: "Inicio", href: "/" }, { label: "Casos clínicos" }];
---

<Base
  title={pageTitle("Casos clínicos")}
  description="Tres casos de ortodoncia documentados etapa por etapa y testimonios de pacientes de la Dra. Edith Noriega. Cada caso es individual y no anticipa resultados."
  schema={[breadcrumbList(SITE_URL, crumbs, `${SITE_URL}/casos/`)]}
>
  <PageHead crumbs={crumbs} eyebrow="Investigación y actualización constante" title="Casos reales para entender cada abordaje" lead="Tres tratamientos documentados etapa por etapa. Tocá una imagen para verla completa. Cada caso es individual y no anticipa el resultado de otro tratamiento." />
  <section class="section" style="padding-top:var(--space-7)">
    <div class="wrap">
      <div class="case-grid">
        {CASES.map((c) => <CaseCard item={c} />)}
      </div>
      <p class="small" style="margin-top:var(--space-6)">Las imágenes fueron publicadas con autorización. Cada tratamiento se indica luego de una evaluación individual y sus tiempos y resultados pueden variar.</p>
    </div>
  </section>
  <VoiceCarousel />
</Base>
