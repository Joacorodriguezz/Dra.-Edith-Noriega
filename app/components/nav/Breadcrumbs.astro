---
interface Props { items: { label: string; href?: string }[] }
const { items } = Astro.props;
---

<nav aria-label="Ruta de navegación">
  <ol class="crumbs">
    {items.map((it) => (
      <li>{it.href ? <a href={it.href}>{it.label}</a> : <span aria-current="page">{it.label}</span>}</li>
    ))}
  </ol>
</nav>
