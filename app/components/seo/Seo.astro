---
import { SITE, SITE_URL } from "../../data/site";
import { baseGraph } from "../../lib/schema";

interface Props {
  title: string;
  description: string;
  /** Nodos JSON-LD extra (MedicalWebPage, BreadcrumbList, FAQPage...) */
  schema?: Record<string, unknown>[];
  noindex?: boolean;
}
const { title, description, schema = [], noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE_URL + "/").href;
const image = SITE_URL + SITE.ogImage;
const graph = { "@context": "https://schema.org", "@graph": [...baseGraph(SITE_URL), ...schema] };
// "<" escapado para que el JSON nunca cierre el <script>
const json = JSON.stringify(graph).replace(/</g, "\\u003c");
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex" />}
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:type" content="website" />
<meta property="og:locale" content="es_AR" />
<meta property="og:site_name" content={SITE.nombre} />
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
<script type="application/ld+json" set:html={json} />
