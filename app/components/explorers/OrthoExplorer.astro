---
import { OX, OX_COLS, OX_ROWS, type OxKey } from "../../data/explorers";

const DEFAULT: OxKey = "metal";
const up: [number, number][] = [[34, 60], [34, 62], [38, 72], [36, 66], [44, 74], [44, 74], [36, 66], [38, 72], [34, 62], [34, 60]];
const lo: [number, number][] = [[32, 52], [32, 54], [34, 60], [28, 52], [28, 52], [28, 52], [28, 52], [34, 60], [32, 54], [32, 52]];

function rowT(list: [number, number][], upper: boolean) {
  const tot = list.reduce((a, b) => a + b[0] + 3, -3);
  let x = 260 - tot / 2;
  const rects: { x: number; y: number; w: number; h: number; rx: number }[] = [];
  const pts: [number, number][] = [];
  for (const [w, h] of list) {
    const cx = x + w / 2;
    const k = (cx - 260) / 220;
    let top: number, bot: number;
    if (upper) { bot = 152 - 16 * k * k; top = bot - h; } else { top = 156 - 10 * k * k; bot = top + h; }
    rects.push({ x, y: top, w, h, rx: w / 3 });
    pts.push([cx, (top + bot) / 2 + (upper ? 4 : -4)]);
    x += w + 3;
  }
  return { rects, pts };
}
const U = rowT(up, true);
const L = rowT(lo, false);
const f = (n: number) => n.toFixed(1);
const wire = (P: [number, number][]) => "M" + P.map((p) => `${f(p[0])} ${f(p[1])}`).join(" L");
---

<div data-ox>
  <div class="seg" role="group" aria-label="Alternativas de ortodoncia" style="margin-bottom:var(--space-5)">
    {OX_COLS.map((k) => <button type="button" data-ox-btn={k} aria-pressed={String(k === DEFAULT) as "true" | "false"}>{OX[k][0]}</button>)}
  </div>
  <div class="split-illus">
    <div>
      <svg class="illus ox" id="oxSvg" data-v={DEFAULT} viewBox="0 0 520 300" role="img" aria-label="Dibujo de frente de los dientes con la alternativa elegida">
        <rect class="gum" x="40" y="34" width="440" height="66" rx="33"></rect>
        <rect class="gum" x="58" y="196" width="404" height="62" rx="31"></rect>
        {[...U.rects, ...L.rects].map((r) => <rect class="t" x={f(r.x)} y={f(r.y)} width={r.w} height={r.h} rx={f(r.rx)}></rect>)}
        <g class="lay l-up-brk brk">
          <path class="wire" d={wire(U.pts)}></path>
          {U.pts.map((p) => <rect x={f(p[0] - 7)} y={f(p[1] - 6)} width="14" height="12" rx="2.5"></rect>)}
        </g>
        <g class="lay l-lo-brk brk">
          <path class="wire" d={wire(L.pts)}></path>
          {L.pts.map((p) => <rect x={f(p[0] - 7)} y={f(p[1] - 6)} width="14" height="12" rx="2.5"></rect>)}
        </g>
        <g class="lay l-up-al"><path class="al" d="M56 74 Q260 66 464 74 L462 144 Q260 164 58 144 Z"></path></g>
        <g class="lay l-lo-al"><path class="al" d="M84 150 Q260 162 436 150 L434 214 Q260 230 86 214 Z"></path></g>
        <g class="lay l-bow">
          <path class="bow" d="M84 128 C120 128 128 108 140 116 C150 124 140 140 160 140 C220 146 300 146 360 140 C380 140 370 124 380 116 C392 108 400 128 436 128"></path>
          <text x="260" y="286" text-anchor="middle">Arco de un aparato removible · ilustración genérica</text>
        </g>
        <text x="40" y="24">Arcada superior</text>
        <text x="58" y="278">Arcada inferior</text>
      </svg>
    </div>
    <div class="en-card" aria-live="polite">
      {OX_COLS.map((k) => (
        <div class="stack" style="gap:var(--space-3)" data-ox-panel={k} hidden={k !== DEFAULT}>
          <p class="eyebrow">Alternativa</p>
          <h3 class="h3">{OX[k][0]}</h3>
          <p class="muted">{OX[k][1]}</p>
          {k === "hibrido" && <p class="small">Es el abordaje del caso de Clase II publicado en <a href="/casos/#caso-03">Casos clínicos</a>.</p>}
          <p class="small">La alternativa se elige después de la evaluación, según el caso, la edad y tus preferencias.</p>
        </div>
      ))}
    </div>
  </div>
  <div class="cmp-wrap">
    <table class="cmp">
      <caption class="sr">Comparación de alternativas de ortodoncia</caption>
      <thead>
        <tr>
          <th scope="col"><span class="sr">Característica</span></th>
          {OX_COLS.map((c) => <th scope="col" data-col={c} class:list={{ sel: c === DEFAULT }}>{OX[c][0]}</th>)}
        </tr>
      </thead>
      <tbody>
        {OX_ROWS.map(([name, vals]) => (
          <tr>
            <th scope="row">{name}</th>
            {vals.map((v, i) => <td data-col={OX_COLS[i]} class:list={{ sel: OX_COLS[i] === DEFAULT }}>{v}</td>)}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</div>

<script>
  import { $, $$ } from "../../lib/dom";
  $$("[data-ox]").forEach((root) => {
    const btns = $$<HTMLButtonElement>("[data-ox-btn]", root);
    btns.forEach((b) =>
      b.addEventListener("click", () => {
        const k = b.dataset.oxBtn;
        btns.forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
        $("#oxSvg", root)?.setAttribute("data-v", k ?? "");
        $$("[data-ox-panel]", root).forEach((p) => (p.hidden = p.dataset.oxPanel !== k));
        $$("[data-col]", root).forEach((c) => c.classList.toggle("sel", c.dataset.col === k));
      })
    );
  });
</script>
